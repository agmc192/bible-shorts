[
0.25,
3.308,
"Ever replayed an argument in your head for hours?"
],
[
3.885,
5.158,
"David knew the feeling."
],
[
5.703,
6.658,
"In Psalm 4,"
],
[
6.868,
9.077,
"people are turning his honor into shame"
],
[
9.355,
10.61,
"and chasing lies."
],
[
11.09,
11.837,
"So he writes:"
],
[
12.216,
13.043,
"\"Be angry,"
],
[
13.267,
14.238,
"and do not sin."
],
[
14.815,
15.505,
"On your bed,"
],
[
15.706,
16.799,
"search your heart,"
],
[
17.114,
17.836,
"and be still.\""
],
[
18.53,
19.218,
"Here's the key."
],
[
19.721,
22.79,
"The Hebrew word for \"be angry\" is rigzu."
],
[
23.228,
24.415,
"It means to tremble,"
],
[
24.666,
25.336,
"to shake."
],
[
25.744,
29.132,
"And the apostle Paul quotes this exact line, then adds,"
],
[
29.411,
31.732,
"\"Don't let the sun go down on your anger.\""
],
[
32.284,
33.861,
"Feeling it isn't the sin."
],
[
34.284,
35.531,
"Feeding it is."
],
[
36.04,
37.937,
"David's answer is trust."
],
[
38.415,
41.826,
